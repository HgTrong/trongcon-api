PORT=8080

JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trongcon
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# USDA FoodData Central — food seed (free key: https://fdc.nal.usda.gov/api-key-signup)
# Leave empty: embedded macros (USDA public domain). With key: call API on startup (seed disabled by default).
USDA_FDC_API_KEY=

# AWS S3 (shared image uploads: categories / articles / common)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Object key prefix in bucket (default: public/images/)
AWS_S3_PREFIX=public/images
# Optional: CDN / CloudFront URL instead of direct S3 URL
AWS_S3_PUBLIC_BASE_URL=

# OpenAI (AI coach — meal plan / routine / training chat)
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60
OPENAI_MODEL=gpt-4o-mini

# AWS SES SMTP (email templates / outbound mail)
SMTP_ENABLED=false
SMTP_NAME=TrongCon
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
